{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile newcombian_bandits.tex",
            "type": "process",
            "command": "/Library/TeX/texbin/latexmk",
            "args": [
                "-pdf",
                "-interaction=nonstopmode",
                "-halt-on-error",
                "-file-line-error",
                "newcombian_bandits.tex"
            ],
            "options": {
                "cwd": "${workspaceFolder}/newcombian"
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        }
    ]
}
